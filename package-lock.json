{
  "name": "hqrelay",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "hqrelay",
      "version": "1.0.0",
      "license": "ISC",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/receiver": {
      "name": "@hqrelay/receiver",
      "version": "1.0.0"
    },
    "apps/worker": {
      "name": "@hqrelay/worker",
      "version": "1.0.0"
    },
    "node_modules/@hqrelay/receiver": {
      "resolved": "apps/receiver",
      "link": true
    },
    "node_modules/@hqrelay/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@hqrelay/worker": {
      "resolved": "apps/worker",
      "link": true
    },
    "packages/shared": {
      "name": "@hqrelay/shared",
      "version": "1.0.0"
    }
  }
}
